// 1. Mengambil batas kabupaten/kota
var adm2 = ee.FeatureCollection(
  'WM/geoLab/geoBoundaries/600/ADM2'
);

// 2. Memilih data Indonesia
var indonesia = adm2.filter(
  ee.Filter.eq('shapeGroup', 'IDN')
);

// 3. Menyiapkan nama wilayah
var dataNama = indonesia.map(function(f) {
  var nama = ee.String(f.get('shapeName')).toLowerCase();
  return f.set('nama_kecil', nama);
});

// 4. Memilih 10 kabupaten/kota Kaltim
var kaltim = dataNama.filter(
  ee.Filter.or(
    ee.Filter.stringContains('nama_kecil', 'paser'),
    ee.Filter.stringContains('nama_kecil', 'kutai'),
    ee.Filter.stringContains('nama_kecil', 'berau'),
    ee.Filter.stringContains('nama_kecil', 'mahakam'),
    ee.Filter.stringContains('nama_kecil', 'balikpapan'),
    ee.Filter.stringContains('nama_kecil', 'samarinda'),
    ee.Filter.stringContains('nama_kecil', 'bontang')
  )
);

// 5. Periksa jumlah dan nama wilayah
print('JUMLAH WILAYAH:', kaltim.size());

print(
  'DAFTAR KABUPATEN/KOTA:',
  kaltim.aggregate_array('shapeName').sort()
);

// 6. Mengambil batas provinsi Kaltim
var adm1 = ee.FeatureCollection(
  'WM/geoLab/geoBoundaries/600/ADM1'
);

var batasProvinsi = adm1
  .filter(ee.Filter.eq('shapeGroup', 'IDN'))
  .filter(ee.Filter.eq('shapeName', 'East Kalimantan'));

