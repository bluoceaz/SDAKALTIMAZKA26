// ==========================================
// TAHAP 2: ANALISIS DYNAMIC WORLD 2016-2023
// LUAS LAHAN TERBANGUN 10 KABUPATEN/KOTA
// ==========================================

// 1. Mengambil data Dynamic World
var dynamicWorld = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1');

// 2. Membuat analisis setiap tahun
var tahunList = ee.List.sequence(2016, 2023);

var hasilDynamicWorld = ee.FeatureCollection(
  tahunList.map(function(tahun) {

    var tanggalAwal = ee.Date.fromYMD(tahun, 1, 1);
    var tanggalAkhir = tanggalAwal.advance(1, 'year');

    // Mengambil citra sesuai tahun dan wilayah Kaltim
    var koleksi = dynamicWorld
      .filterDate(tanggalAwal, tanggalAkhir)
      .filterBounds(kaltim);

    // Menghitung kelas tutupan lahan dominan
    var labelTahunan = koleksi
      .select('label')
      .reduce(ee.Reducer.mode())
      .rename('label');

    // Kelas 6 = Built Area / Lahan Terbangun
    var lahanTerbangun = labelTahunan.eq(6);

    // Menghitung luas dalam meter persegi
    var luasM2 = lahanTerbangun
      .multiply(ee.Image.pixelArea())
      .rename('area_m2');

    // Menghitung luas setiap kabupaten/kota
    var statistik = luasM2.reduceRegions({
      collection: kaltim,
      reducer: ee.Reducer.sum().setOutputs(['luas_m2']),
      scale: 100,
      tileScale: 4
    });

    // Mengubah hasil menjadi hektare
    return statistik.map(function(fitur) {

      return ee.Feature(null, {
        kabupaten_kota: fitur.get('shapeName'),
        tahun: tahun,
        luas_terbangun_ha:
          ee.Number(fitur.get('luas_m2')).divide(10000)
      });

    });

  })
).flatten();

// 3. Menampilkan hasil analisis
print('HASIL DYNAMIC WORLD 2016-2023:',
      hasilDynamicWorld);

print('JUMLAH DATA:',
      hasilDynamicWorld.size());

// 4. Mengekspor hasil ke Google Drive
Export.table.toDrive({
  collection: hasilDynamicWorld,
  description: 'DYNAMIC_WORLD_KALTIM_2016_2023',
  fileFormat: 'CSV',
  selectors: [
    'kabupaten_kota',
    'tahun',
    'luas_terbangun_ha'
  ]
});

print('ANALISIS DYNAMIC WORLD SELESAI');
